+.material-icon .material-icon-empty { color: #8a96a9; font-size: 22px; }
+.material-section-title { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 38px; margin-bottom: 8px; }
+.material-section-title h3 { margin: 0; }.material-section-title button { padding: 5px 9px; font-size: 12px; white-space: nowrap; }
+.material-export { margin-top: 14px; flex-wrap: wrap; }.material-export label { display: flex; align-items: center; gap: 8px; }
+
+.material-dialog input[type=search] { color: #e6e9ef; background: #161b23; border: 1px solid #475366; border-radius: 6px; padding: 10px 12px; box-sizing: border-box; }
+.material-export label { white-space: nowrap; }
+#materialStatus { overflow-wrap: anywhere; }
diff --git "a/\345\220\257\345\212\250.bat" "b/\345\220\257\345\212\250.bat"
deleted file mode 100644
index 700740c..0000000
--- "a/\345\220\257\345\212\250.bat"
+++ /dev/null
@@ -1,30 +0,0 @@
-@echo off
-rem Litematic Render desktop launcher (Electron shell + Java engine).
-setlocal
-chcp 65001 >nul
-set "DIR=%~dp0"
-
-set "ELECTRON=%DIR%webapp\node_modules\electron\dist\electron.exe"
-if not exist "%ELECTRON%" (
-    echo [ERROR] Electron not found:
-    echo         %ELECTRON%
-    echo Run install.bat first to fetch runtime dependencies.
-    pause
-    exit /b 1
-)
-
-rem Electron refuses to create windows while this is inherited from a parent shell. Some tooling
-rem (including the harness this project is developed in) exports ELECTRON_RUN_AS_NODE globally, which
-rem makes require('electron') resolve as plain Node and crash the main process with
-rem "Cannot read properties of undefined (reading 'handle')" before the engine ever starts.
-set "ELECTRON_RUN_AS_NODE="
-
-rem /wait keeps this console attached, so a main-process crash prints its stack here instead of
-rem vanishing; start without /wait would swallow it and leave only an empty log file.
-start /wait "" "%ELECTRON%" "%DIR%webapp"
-if errorlevel 1 (
-    echo.
-    echo [ERROR] The app exited with code %errorlevel%. The stack trace above, if any, names the cause.
-    pause
-)
-endlocal
\ No newline at end of file
