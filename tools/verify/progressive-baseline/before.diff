-/** The CSS colour matching each backdrop option, so the DOM and the framebuffer agree. */
-function cssColor(mode) {
-  switch (mode) {
-    case 'sky':   return '#8cb3ff';
-    case 'white': return '#ffffff';
-    case 'dark':  return '#292e36';
-    default:      return '';
